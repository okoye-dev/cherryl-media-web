# ==============================================================================
# Cherryl Media Web — Frontend Environment Variables
# ==============================================================================

# URL of the Go Media Engine backend (media-engine)
# In local development: http://localhost:8080
# In production: https://engine.cherrylmedia.com or https://api.cherrylmedia.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public site URL (used for OpenGraph and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Public CDN / Cloudflare R2 Domain for images (if overriding default engine public URLs)
# NEXT_PUBLIC_CDN_URL=https://pub-f466d3b063d789b6298887ee0c821614.r2.dev
